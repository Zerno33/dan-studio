# ============================================================
# Skopiuj do .env.local (lokalnie) i ustaw w Vercel → Settings →
# Environment Variables (produkcja/preview).
# .env.local jest w .gitignore — NIGDY nie commituj realnych wartości.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Publiczne (klient). URL może być tym samym co SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM (MYS-13) — decyzja: direct OpenAI/xAI; LiteLLM opcjonalny ---
# Jeśli LITELLM_BASE_URL i LITELLM_MASTER_KEY są ustawione, proxy ma pierwszeństwo.
# W przeciwnym razie wywołania idą bezpośrednio (brak idle Railway).
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=

# Direct (MYS-14): klucze tylko server-side. Ustaw limity wydatków w panelu providera.
OPENAI_API_KEY=
XAI_API_KEY=
OPENAI_MODEL_LUNA=gpt-4o-mini
OPENAI_MODEL_TERRA=gpt-4o
XAI_MODEL_43=grok-3
XAI_MODEL_46=grok-3

# Webhook MoR (MYS-23/24). Header: x-webhook-secret albo Authorization Bearer.
MOR_WEBHOOK_SECRET=

# Beta: przecinek emaili z zakładką admin. BEZ tej listy nikt nie jest adminem
# (nie ma „pierwszy signup = admin”). Po zmianie: Redeploy na Vercel.
ADMIN_EMAILS=
STARTER_CREDITS=50
