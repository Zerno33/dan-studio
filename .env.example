# ============================================================
# Skopiuj do .env.local (lokalnie) i ustaw w Vercel → Settings →
# Environment Variables (produkcja/preview).
# .env.local jest w .gitignore — NIGDY nie commituj realnych wartości.
# ============================================================

# --- Supabase ---
# Project Settings → API → Project URL
SUPABASE_URL=https://twoj-projekt.supabase.co

# Project Settings → API → service_role (SECRET, nie anon!)
# Ten klucz omija RLS. Wyłącznie server-side, nigdy w kodzie klienta.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiteLLM proxy (MYS-13) ---
# UWAGA: instancja na Railway jest obecnie intencjonalnie zapauzowana.
# Do rozstrzygnięcia w MYS-13, czy zostaje proxy, czy wywołania idą
# bezpośrednio do OpenAI/xAI (tańsze — brak kosztu idle Railway).
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
